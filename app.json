{
  "expo": {
    "name": "lazarusreportApp",
    "slug": "lazarusreportApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logolazarusreport.png",
    "scheme": "lazarusreportapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lazarus.report"
    },
    "android": {
      "package": "com.lazarus.report",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logolazarusreport.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logolazarusreport.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "apiKeys": {},
      "router": {},
      "eas": {
        "projectId": "78d16f29-49ca-4b28-87fb-c327d79e0f26"
      }
    }
  }
}
